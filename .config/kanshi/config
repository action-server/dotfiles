profile default {
	output "DP-8" {
		mode  1920x1080@60.0Hz
		position 0,0
		transform normal
		adaptive_sync on
		scale 1
	}
	output "DP-9" {
		mode  1920x1080@60.0Hz
		position 1920,0
		transform normal
		adaptive_sync on
		scale 1
	}

	exec swaymsg 'workspace 1 output DP-8'
	exec swaymsg 'workspace 2 output DP-8'
	exec swaymsg 'move workspace to DP-8'
}
