# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
}

order += "cpu_temperature all"
order += "memory"
order += "disk /"
order += "volume master"
order += "battery all"
order += "tztime local"

wireless _first_ {
        format_up = "󰖩"
        format_down = "󰖪"
}

ethernet _first_ {
        format_up = "󰌘"
        format_down = "󰌙"
}

memory {
        format = "󰍛 %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

disk "/" {
        format = "󰋊 %avail"
}

cpu_temperature all{
        format = "󰔏 %degrees °C"
}

volume master {
        format = "󰕾 %volume"
        format_muted = "󰖁 %volume"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

battery all {
        format = "%status %percentage %remaining"
				format_down = ""
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}
